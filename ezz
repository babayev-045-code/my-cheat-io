    function BABA_AutoLootTick() {
        if (!BABA_MOD.FAutoLootEnabled && !BABA_MOD.SAutoLootEnabled) return;

        try {
            if (typeof World === "undefined" || !World.PLAYER) return;

            var now = Date.now();
            var isFast = BABA_MOD.FAutoLootEnabled;
            
            var delayLimit = isFast ? 20 : 350; 
            var maxItems = isFast ? 8 : 1; 

            if (now - BABA_MOD._lastLoot < delayLimit) return;

            var lootId = World.PLAYER.ᴇܗ̶;
            if (lootId === undefined || lootId === null || lootId < 0) {
                lootId = World.PLAYER.Ꮷ̡ࡇ;
            }

            if (!isFast && (lootId === undefined || lootId === null || lootId < 0)) {
                return;
            }

            BABA_MOD._lastLoot = now;

            if (lootId !== undefined && lootId !== null && lootId >= 0) {
                BABA_NetSend([12, lootId]);
            }

            if (!isFast) return;

            if (typeof Entitie === "undefined" || !Entitie["ɑᴏᚁ"]) return;
            var me = BABA_GetPos(World.PLAYER);
            if (!me) return;

            var range2 = 90000;
            var sent = 0;

            for (var ti = 1; ti <= 15 && sent < maxItems; ti++) {
                var units = Entitie["ɑᴏᚁ"][ti];
                if (!units) continue;

                var count = 0;
                try { count = units.length || 0; } catch (e) {}

                for (var i = 0; i < count && sent < maxItems; i++) {
                    var ent = null;
                    try { ent = units[i]; } catch (e) {}
                    if (!ent) continue;

                    var pos = BABA_GetPos(ent);
                    if (!pos) continue;

                    var dx = me.ࡀ️٥ - pos.ࡀ️٥, dy = me.ᴑ५８ - pos.ᴑ५８;
                    if (dx * dx + dy * dy >= range2) continue;

                    var lid = undefined;
                    try { lid = ent[ㅤ︆٩]; } catch (e) {}
                    if (lid === undefined) try { lid = ent.id; } catch (e) {}
                    if (lid === undefined || lid === null || lid < 0) continue;
                    if (lid === lootId) continue;

                    BABA_NetSend([12, lid]);
                    sent++;
                }
            }
        } catch (err) {}
    }

