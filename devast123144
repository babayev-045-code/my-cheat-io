 var aimX = innerWidth/2, aimY = innerHeight/2;
 var lastAimX = aimX, lastAimY = aimY;
 var realMouseX = innerWidth/2, realMouseY = innerHeight/2;
 var aimbotSyncFn = null;
 var lockedTarget = null;
 var gameCanvas = null;
 var isPointerLocked = false;

 var _origClientX = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'clientX')?.get;
 var _origClientY = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'clientY')?.get;
 var _origMovementX = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'movementX')?.get;
 var _origMovementY = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'movementY')?.get;
 var _origScreenX = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'screenX')?.get;
 var _origScreenY = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'screenY')?.get;
 var _origPageX = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'pageX')?.get;
 var _origPageY = Object.getOwnPropertyDescriptor(MouseEvent.prototype, 'pageY')?.get;

 var _origPClientX = Object.getOwnPropertyDescriptor(PointerEvent.prototype, 'clientX')?.get || _origClientX;
 var _origPClientY = Object.getOwnPropertyDescriptor(PointerEvent.prototype, 'clientY')?.get || _origClientY;
 var _origPMovementX = Object.getOwnPropertyDescriptor(PointerEvent.prototype, 'movementX')?.get || _origMovementX;
 var _origPMovementY = Object.getOwnPropertyDescriptor(PointerEvent.prototype, 'movementY')?.get || _origMovementY;

 document.addEventListener('pointerlockchange', function() {
   isPointerLocked = !!document.pointerLockElement;
 });

 function overrideProp(proto, prop, getter) {
   try { Object.defineProperty(proto, prop, { get: getter, configurable: true }); } catch(e) {}
 }

 if (_origClientX && _origClientY) {
   overrideProp(MouseEvent.prototype, 'clientX', function() {
     if (this._aim) return _origClientX.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimX);
     return _origClientX.call(this);
   });
   overrideProp(MouseEvent.prototype, 'clientY', function() {
     if (this._aim) return _origClientY.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimY);
     return _origClientY.call(this);
   });
 }

 if (_origMovementX) {
   overrideProp(MouseEvent.prototype, 'movementX', function() {
     if (this._aim) return _origMovementX.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimX - lastAimX);
     return _origMovementX.call(this);
   });
 }
 if (_origMovementY) {
   overrideProp(MouseEvent.prototype, 'movementY', function() {
     if (this._aim) return _origMovementY.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimY - lastAimY);
     return _origMovementY.call(this);
   });
 }

 if (_origScreenX) {
   overrideProp(MouseEvent.prototype, 'screenX', function() {
     if (this._aim) return _origScreenX.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimX + window.screenX);
     return _origScreenX.call(this);
   });
 }
 if (_origScreenY) {
   overrideProp(MouseEvent.prototype, 'screenY', function() {
     if (this._aim) return _origScreenY.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimY + window.screenY);
     return _origScreenY.call(this);
   });
 }

 if (_origPageX) {
   overrideProp(MouseEvent.prototype, 'pageX', function() {
     if (this._aim) return _origPageX.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimX);
     return _origPageX.call(this);
   });
 }
 if (_origPageY) {
   overrideProp(MouseEvent.prototype, 'pageY', function() {
     if (this._aim) return _origPageY.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimY);
     return _origPageY.call(this);
   });
 }

 if (_origPClientX) {
   overrideProp(PointerEvent.prototype, 'clientX', function() {
     if (this._aim) return _origPClientX.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimX);
     return _origPClientX.call(this);
   });
   overrideProp(PointerEvent.prototype, 'clientY', function() {
     if (this._aim) return _origPClientY.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimY);
     return _origPClientY.call(this);
   });
 }

 if (_origPMovementX) {
   overrideProp(PointerEvent.prototype, 'movementX', function() {
     if (this._aim) return _origPMovementX.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimX - lastAimX);
     return _origPMovementX.call(this);
   });
   overrideProp(PointerEvent.prototype, 'movementY', function() {
     if (this._aim) return _origPMovementY.call(this);
     if (settings.Aimbot && lockedTarget) return Math.round(aimY - lastAimY);
     return _origPMovementY.call(this);
   });
 }

 document.addEventListener('mousemove', function(e) {
   if (e._aim) return;
   var rx = _origClientX ? _origClientX.call(e) : e.clientX;
   var ry = _origClientY ? _origClientY.call(e) : e.clientY;

   realMouseX = rx;
   realMouseY = ry;

   if (!settings.Aimbot || !lockedTarget) {
     aimX = rx;
     aimY = ry;
     lastAimX = rx;
     lastAimY = ry;
   }
 }, true);

 function setAimbot(val) {
   settings.Aimbot = val;
   if (!val) {
     lockedTarget = null;
     aimX = realMouseX;
     aimY = realMouseY;
     lastAimX = realMouseX;
     lastAimY = realMouseY;
   }
   if (aimbotSyncFn) aimbotSyncFn();
   updateStatusHUD();
 }

 function updateAimbot() {
   if (!settings.Aimbot) {
     lockedTarget = null;
     aimX = realMouseX;
     aimY = realMouseY;
     lastAimX = realMouseX;
     lastAimY = realMouseY;
     return;
   }

   var closestTarget = null;
   var minDistance = Infinity;

   for (var i = 0; i < prevFrameEntities.length; i++) {
     var entity = prevFrameEntities[i];
     if (!entity || typeof entity.scx !== 'number' || typeof entity.scy !== 'number') continue;

     var distance = Math.hypot(entity.scx - realMouseX, entity.scy - realMouseY);
     if (distance < minDistance) {
       minDistance = distance;
       closestTarget = entity;
     }
   }

   if (closestTarget) {
     lockedTarget = closestTarget;
     var predFrames = settings.PredFrames || 8;
     var targetX = lockedTarget.scx + (lockedTarget.vx || 0) * predFrames;
     var targetY = lockedTarget.scy + (lockedTarget.vy || 0) * predFrames;

     aimX = targetX;
     aimY = targetY;
   } else {
     lockedTarget = null;
     aimX = realMouseX;
     aimY = realMouseY;
   }
 }

 function sendAimEvents() {
   if (!settings.Aimbot || !lockedTarget || !gameCanvas) return;

   var moveX = Math.round(aimX - lastAimX);
   var moveY = Math.round(aimY - lastAimY);

   if (Math.abs(moveX) < 1 && Math.abs(moveY) < 1) {
     var dx = lockedTarget.scx - lastAimX;
     var dy = lockedTarget.scy - lastAimY;
     var dist = Math.hypot(dx, dy);
     if (dist > 0) {
       moveX = Math.round((dx / dist) * 2);
       moveY = Math.round((dy / dist) * 2);
       aimX = lastAimX + moveX;
       aimY = lastAimY + moveY;
     }
   }

   var mouseEv = new MouseEvent('mousemove', {
     clientX: Math.round(aimX),
     clientY: Math.round(aimY),
     movementX: moveX,
     movementY: moveY,
     screenX: Math.round(aimX + window.screenX),
     screenY: Math.round(aimY + window.screenY),
     bubbles: true,
     cancelable: true,
     view: window
   });
   Object.defineProperty(mouseEv, '_aim', { value: true, configurable: true });

   var pointerEv;
   try {
     pointerEv = new PointerEvent('pointermove', {
       clientX: Math.round(aimX),
       clientY: Math.round(aimY),
       movementX: moveX,
       movementY: moveY,
       pointerId: 1,
       pointerType: 'mouse',
       bubbles: true,
       cancelable: true,
       view: window
     });
     Object.defineProperty(pointerEv, '_aim', { value: true, configurable: true });
   } catch(e) {}

   document.dispatchEvent(mouseEv);
   if (pointerEv) document.dispatchEvent(pointerEv);

   gameCanvas.dispatchEvent(mouseEv);
   if (pointerEv) gameCanvas.dispatchEvent(pointerEv);

   lastAimX = aimX;
   lastAimY = aimY;
 }

