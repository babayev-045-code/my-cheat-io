 var autoRunIv = null;
 function shiftEv(type) {
   var o = { key:"Shift", code:"ShiftLeft", keyCode:16, which:16, shiftKey:type==="keydown", bubbles:true, cancelable:true };
   window.dispatchEvent(new KeyboardEvent(type, o));
   document.dispatchEvent(new KeyboardEvent(type, o));
   var c = document.querySelector("canvas"); if (c) c.dispatchEvent(new KeyboardEvent(type, o));
 }
 function startAutoRun() {
   if (autoRunIv) return;
   shiftEv("keydown");
   autoRunIv = setInterval(function(){ shiftEv("keydown"); }, 50);
   updateStatusHUD();
 }
 function stopAutoRun()  {
   if (autoRunIv) { clearInterval(autoRunIv); autoRunIv = null; }
   shiftEv("keyup");
   updateStatusHUD();
 }
 function applyAutoRun(val) {
   settings.AutoRun = val;
   if (val) startAutoRun();
   else stopAutoRun();
   updateStatusHUD();
 }

 // ============================================================
 // SOLARIS ESP / AUTOLOOT / PREDICTION
 // ============================================================
 var overlayCanvas = null, overlayCtx = null;
 var pendingDrawCalls = [], prevFrameEntities = [];
 var selfImageRef = null, selfEntity = null;
 var selfScreenX = innerWidth/2, selfScreenY = innerHeight/2;
 var mouseX = innerWidth/2, mouseY = innerHeight/2;
 var lastLootSeenAt = 0, lastLoot2SeenAt = 0, lastLootKeyTime = 0;
 var selfVelX = 0, selfVelY = 0;
 var prevSelfScreenX = null, prevSelfScreenY = null;
 var selfLastSeenAt = 0;
 var currentTarget = null;
 var cheatStarted = false;
 var autolootIv = null;

 function isXrayTarget(src) {
   var s = src.toLowerCase();
   return s.includes("wall")||s.includes("door")||s.includes("tree")||
          (s.includes("wood")&&(s.includes("trunk")||s.includes("log")))||
          s.includes("bush")||s.includes("plant")||s.includes("shrub")||
          s.includes("grass")||s.includes("rock")||s.includes("cactus")||
          s.includes("floor")||s.includes("ground");
 }

 function dispatchLootKey(k) {
   var code = k.toUpperCase().charCodeAt(0);
   document.dispatchEvent(new KeyboardEvent("keydown", { key:k, code:"Key"+k.toUpperCase(), keyCode:code, which:code, bubbles:true }));
   setTimeout(function(){ document.dispatchEvent(new KeyboardEvent("keyup", { key:k, code:"Key"+k.toUpperCase(), keyCode:code, which:code, bubbles:true })); }, 60);
 }

 function findCanvas() {
   var check = setInterval(function() {
     var c = document.getElementById("can") || document.querySelector("canvas");
     if (c && c.width > 300 && c.height > 300) {
       gameCanvas = c;
       clearInterval(check);
       setTimeout(startCheat, 3000);
     }
   }, 500);
 }

 function startCheat() {
   if (cheatStarted || !gameCanvas) return;
   cheatStarted = true;

   document.addEventListener("mousemove", function(e){ mouseX=e.clientX; mouseY=e.clientY; }, {passive:true});
   if (settings.AutoRun) startAutoRun();

   if (!gameCanvas.__hooked) {
     gameCanvas.__hooked = true;
     var ctx = gameCanvas.getContext("2d");
     var origDraw = ctx.drawImage.bind(ctx);
     ctx.drawImage = function() {
       var args = arguments;
       if (settings.XRay && args.length >= 3 && args[0] && args[0].src) {
         if (isXrayTarget(args[0].src)) {
           this.globalAlpha = Math.max(0.01, settings.XRayAlpha);
           origDraw.apply(this, args);
           this.globalAlpha = 1;
           return;
         }
       }
       origDraw.apply(this, args);
       if (args.length >= 3 && args[0] && args[0].src) {
         var src = args[0].src;
         var isSkin  = (src.includes("-skin")||src.includes("_skin")) && !src.includes("hand") && !src.includes("arm");
         var isLoot  = src.includes("loot.png")  && !src.includes("loot2.png");
         var isLoot2 = src.includes("loot2.png");
         if (isLoot)  lastLootSeenAt  = Date.now();
         if (isLoot2) lastLoot2SeenAt = Date.now();
         if (isSkin) {
           var dx,dy,dw,dh;
           if (args.length===3){dx=args[1];dy=args[2];dw=args[0].width||32;dh=args[0].height||32;}
           else if(args.length===5){dx=args[1];dy=args[2];dw=args[3];dh=args[4];}
           else if(args.length===9){dx=args[5];dy=args[6];dw=args[7];dh=args[8];}
           else return;
           var t=this.getTransform();
           var wx=t.e+(t.a*(dx+dw/2)+t.c*(dy+dh/2));
           var wy=t.f+(t.b*(dx+dw/2)+t.d*(dy+dh/2));
           pendingDrawCalls.push({dx,dy,dw,dh,t,img:args[0],worldX:wx,worldY:wy});
         }
       }
     };
   }

   if (!overlayCanvas) {
     overlayCanvas = document.createElement("canvas");
     overlayCanvas.style.cssText = "position:fixed;top:0;left:0;width:100%;height:100%;pointer-events:none;z-index:9999990;";
     document.body.appendChild(overlayCanvas);
     overlayCtx = overlayCanvas.getContext("2d");
     function rs(){ overlayCanvas.width=innerWidth; overlayCanvas.height=innerHeight; } rs();
     window.addEventListener("resize", rs);
     renderLoop();
   }

   autolootIv = setInterval(function() {
     if (!settings.Autoloot) return;
     if (document.activeElement && (document.activeElement.tagName==="INPUT"||document.activeElement.tagName==="TEXTAREA")) return;
     var now = Date.now();
     if (now - lastLootKeyTime < 10) return;
     if (now - lastLoot2SeenAt < 300) {
       dispatchLootKey("f"); lastLootKeyTime = now;
     } else if (now - lastLootSeenAt < 300) {
       dispatchLootKey("e"); dispatchLootKey("f"); lastLootKeyTime = now;
     }
   }, 10);
 }

 function canvasToScreen(cx,cy) {
   if (!gameCanvas) return {x:cx,y:cy};
   var r = gameCanvas.getBoundingClientRect();
   return {x:r.left+cx*(r.width/(gameCanvas.width||1)), y:r.top+cy*(r.height/(gameCanvas.height||1))};
 }

 function renderLoop() {
   if (!overlayCtx||!gameCanvas) { requestAnimationFrame(renderLoop); return; }
   var ctx=overlayCtx, W=overlayCanvas.width, H=overlayCanvas.height;
   ctx.clearRect(0,0,W,H);
   var entries=pendingDrawCalls; pendingDrawCalls=[];
   var scr=[], now=Date.now();

   for(var i=0;i<entries.length;i++){
     var e=entries[i],t=e.t;
     var rad=Math.min(e.dw,e.dh)/2*Math.hypot(t.a,t.b);
     var sp=canvasToScreen(e.worldX,e.worldY);
     scr.push({scx:sp.x,scy:sp.y,radius:rad||18,img:e.img,worldX:e.worldX,worldY:e.worldY});
   }
   for(var i=0;i<scr.length;i++){
     var vx=0,vy=0,best=Infinity;
     for(var j=0;j<prevFrameEntities.length;j++){
       var d=Math.hypot(scr[i].scx-prevFrameEntities[j].scx,scr[i].scy-prevFrameEntities[j].scy);
       if(d<best&&d<40){best=d;vx=scr[i].scx-prevFrameEntities[j].scx;vy=scr[i].scy-prevFrameEntities[j].scy;}
     }
     scr[i].vx=vx; scr[i].vy=vy;
   }
   prevFrameEntities=scr.map(function(e){return{scx:e.scx,scy:e.scy,vx:e.vx,vy:e.vy};});

   var matched=false;
   if(selfImageRef){for(var i=0;i<scr.length;i++){if(scr[i].img===selfImageRef){selfEntity=scr[i];scr[i].isMe=true;selfLastSeenAt=now;matched=true;break;}}}
   if(!matched){selfEntity=null;if(now-selfLastSeenAt>2000)selfImageRef=null;}
   if(!selfImageRef){var best=200,bestE=null;for(var i=0;i<scr.length;i++){var d=Math.hypot(scr[i].scx-W/2,scr[i].scy-H/2);if(d<best){best=d;bestE=scr[i];}}if(bestE){selfImageRef=bestE.img;selfEntity=bestE;bestE.isMe=true;selfLastSeenAt=now;}}
   if(selfEntity){selfScreenX=selfEntity.scx;selfScreenY=selfEntity.scy;}
   if(prevSelfScreenX!==null){selfVelX=selfScreenX-prevSelfScreenX;selfVelY=selfScreenY-prevSelfScreenY;}
   prevSelfScreenX=selfScreenX;prevSelfScreenY=selfScreenY;

   currentTarget=null;var minD=Infinity;
   for(var i=0;i<scr.length;i++){
     if(scr[i].isMe)continue;
     var d=Math.hypot(scr[i].scx-realMouseX,scr[i].scy-realMouseY);
     if(d<minD){minD=d;currentTarget=scr[i];}
   }

   updateAimbot();
   sendAimEvents();

   if(settings.ESP){
     for(var i=0;i<scr.length;i++){
       if(scr[i].isMe)continue;
       ctx.strokeStyle="#ffffff";ctx.lineWidth=1.5;
       ctx.beginPath();ctx.arc(scr[i].scx,scr[i].scy,scr[i].radius,0,Math.PI*2);ctx.stroke();
     }
   }

   if(settings.Aimbot && selfEntity && lockedTarget){
     var predX=lockedTarget.scx+(lockedTarget.vx||0)*settings.PredFrames;
     var predY=lockedTarget.scy+(lockedTarget.vy||0)*settings.PredFrames;

     ctx.beginPath();ctx.moveTo(selfScreenX,selfScreenY);ctx.lineTo(predX,predY);
     ctx.strokeStyle=settings.AimColor;ctx.lineWidth=2;
     ctx.stroke();

     ctx.beginPath();ctx.arc(predX,predY,6,0,Math.PI*2);
     ctx.strokeStyle=settings.AimColor;ctx.lineWidth=2;ctx.stroke();

     ctx.strokeStyle="#00ff00";ctx.lineWidth=2;
     ctx.beginPath();ctx.arc(lockedTarget.scx,lockedTarget.scy,lockedTarget.radius+5,0,Math.PI*2);ctx.stroke();
   }

   requestAnimationFrame(renderLoop);
 }

