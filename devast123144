 function hookXrayCtx(){
   var canvas=document.getElementById("can");
   if(!canvas){setTimeout(hookXrayCtx,500);return;}
   var ctx=canvas.getContext("2d");if(!ctx)return;
   var methods=["fillRect","strokeRect","fill","stroke","fillText","strokeText"];
   var orig={};
   methods.forEach(function(m){
     if(!ctx[m])return;
     orig[m]=ctx[m].bind(ctx);
     ctx[m]=function(){
       if(settings.XRay){var s=ctx.globalAlpha;ctx.globalAlpha=Math.min(s,Math.max(0.01,settings.XRayAlpha));var r=orig[m].apply(ctx,arguments);ctx.globalAlpha=s;return r;}
       return orig[m].apply(ctx,arguments);
     };
   });
   var oSave=ctx.save.bind(ctx),oRest=ctx.restore.bind(ctx);
   ctx.save=function(){oSave();};
   ctx.restore=function(){oRest();if(settings.XRay)ctx.globalAlpha=Math.min(ctx.globalAlpha,Math.max(0.01,settings.XRayAlpha));};
 }
 hookXrayCtx();

