 function setAimbot(val) {
   settings.Aimbot = val;
   if (!val) {
     lockedTarget = null;
     aimX = realMouseX;
     aimY = realMouseY;
     lastAimX = realMouseX;
     lastAimY = realMouseY;
   }
   if (aimbotSyncFn) aimbotSyncFn();
   updateStatusHUD();
 }

 function updateAimbot() {
   if (!settings.Aimbot) {
     lockedTarget = null;
     aimX = realMouseX;
     aimY = realMouseY;
     lastAimX = realMouseX;
     lastAimY = realMouseY;
     return;
   }

   var closestTarget = null;
   var minDistance = Infinity;

   for (var i = 0; i < prevFrameEntities.length; i++) {
     var entity = prevFrameEntities[i];
     if (!entity || typeof entity.scx !== 'number' || typeof entity.scy !== 'number') continue;

     var distance = Math.hypot(entity.scx - realMouseX, entity.scy - realMouseY);
     if (distance < minDistance) {
       minDistance = distance;
       closestTarget = entity;
     }
   }

   if (closestTarget) {
     lockedTarget = closestTarget;
     var predFrames = settings.PredFrames || 8;
     var targetX = lockedTarget.scx + (lockedTarget.vx || 0) * predFrames;
     var targetY = lockedTarget.scy + (lockedTarget.vy || 0) * predFrames;

     aimX = targetX;
     aimY = targetY;
   } else {
     lockedTarget = null;
     aimX = realMouseX;
     aimY = realMouseY;
   }
 }

 function sendAimEvents() {
   if (!settings.Aimbot || !lockedTarget || !gameCanvas) return;

   var moveX = Math.round(aimX - lastAimX);
   var moveY = Math.round(aimY - lastAimY);

   if (Math.abs(moveX) < 1 && Math.abs(moveY) < 1) {
     var dx = lockedTarget.scx - lastAimX;
     var dy = lockedTarget.scy - lastAimY;
     var dist = Math.hypot(dx, dy);
     if (dist > 0) {
       moveX = Math.round((dx / dist) * 2);
       moveY = Math.round((dy / dist) * 2);
       aimX = lastAimX + moveX;
       aimY = lastAimY + moveY;
     }
   }

   var mouseEv = new MouseEvent('mousemove', {
     clientX: Math.round(aimX),
     clientY: Math.round(aimY),
     movementX: moveX,
     movementY: moveY,
     screenX: Math.round(aimX + window.screenX),
     screenY: Math.round(aimY + window.screenY),
     bubbles: true,
     cancelable: true,
     view: window
   });
   Object.defineProperty(mouseEv, '_aim', { value: true, configurable: true });

   var pointerEv;
   try {
     pointerEv = new PointerEvent('pointermove', {
       clientX: Math.round(aimX),
       clientY: Math.round(aimY),
       movementX: moveX,
       movementY: moveY,
       pointerId: 1,
       pointerType: 'mouse',
       bubbles: true,
       cancelable: true,
       view: window
     });
     Object.defineProperty(pointerEv, '_aim', { value: true, configurable: true });
   } catch(e) {}

   document.dispatchEvent(mouseEv);
   if (pointerEv) document.dispatchEvent(pointerEv);

   gameCanvas.dispatchEvent(mouseEv);
   if (pointerEv) gameCanvas.dispatchEvent(pointerEv);

   lastAimX = aimX;
   lastAimY = aimY;
 }

