 function handleKey(e){
   var tag=document.activeElement&&document.activeElement.tagName;
   var inInp=tag==="INPUT"||tag==="TEXTAREA";
   if(inInp)return;

   if(e.code===settings.Keys.Menu){
     e.preventDefault();e.stopPropagation();
     menuVisible=!menuVisible;
     if(guiRoot)guiRoot.style.display=menuVisible?"flex":"none";
     return;
   }
   if(e.code===settings.Keys.XRay){
     e.preventDefault();e.stopPropagation();
     settings.XRay=!settings.XRay;
     if(xraySyncFn)xraySyncFn();
     updateStatusHUD();
     return;
   }
   if(e.code===settings.Keys.Aimbot){
     e.preventDefault();e.stopPropagation();
     setAimbot(!settings.Aimbot);
     return;
   }
   if(e.code===settings.Keys.Autoloot){
     e.preventDefault();e.stopPropagation();
     settings.Autoloot=!settings.Autoloot;
     updateStatusHUD();
     return;
   }
   if(settings.AutoRun&&(e.code==="ShiftLeft"||e.code==="ShiftRight")){
     e.preventDefault();e.stopPropagation();
   }
 }
 document.addEventListener("keydown",handleKey,true);
